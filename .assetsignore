# If the Build output directory is set to the repo root (/), Cloudflare scans and uploads everything below.
# This file excludes them (especially .git, whose pack files are hundreds of MB and hit the 25 MiB per-file limit).
.git
.github
.gitignore
.workbuddy
dist
docs
node_modules
scripts
README.md
LICENSE
download_failed.txt
verify_failed.txt
.DS_Store
